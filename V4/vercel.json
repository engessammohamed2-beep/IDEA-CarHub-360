{
  "crons": [
    {
      "path": "/api/whatsapp/send-morning-message",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/app/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ]
}
