# ===================== IDEA CarHub 360 — License Layer =====================
# انسخ الملف ده باسم .env.local للتجربة محليًا
# ولو هترفعه على Vercel: ضيف نفس المتغيرات دي في Project Settings > Environment Variables

# ---- Admin ----
# الباسورد الثابت بتاع الأدمن (متسيبوش القيمة الافتراضية دي في الإنتاج)
ADMIN_PASSWORD=change-this-super-secret-password

# مفتاح سري لتوقيع الـ session cookies (اي نص عشوائي طويل)
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars

# ---- Google Sheets (Service Account) ----
# من Google Cloud Console: أنشئ Service Account وفعّل Google Sheets API
# شارك الـ Google Sheet بتاعك (Editor access) مع الـ client_email بتاع الـ Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# الصق الـ private key كامل بين علامتي تنصيص، مع الاحتفاظ بـ \n داخل السطر
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"
# الـ ID بتاع الشيت (من رابط الشيت نفسه)
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# أسماء التابات (sheets) داخل الملف - غيرها لو مختلفة عندك
SHEET_TAB_CARS=Cars
SHEET_TAB_LICENSES=Licenses
SHEET_TAB_CLIENT_DATA=ClientData
SHEET_TAB_SHARED_MODELS=SharedModels
SHEET_TAB_CAR_SPECS=CarSpecs
# ملحوظة: SHEET_TAB_CAR_SPECS_CACHE بقى مش مستخدم بعد إلغاء الاعتماد على مواقع خارجية
# (CarQuery وغيره) — مفيش داعي تمسحه لو موجود عندك، بس البرنامج مبقاش بينادي عليه.
SHEET_TAB_CAR_SPECS_CACHE=CarSpecsCache
# التاب الجديد اللي بيتخزن فيه أي عربية "اتعلمناها" من Gemini (موديل جديد أو سنة جديدة)
SHEET_TAB_CAR_SPECS_CATALOG=CarSpecsCatalog
# سجل رسائل واتساب (واردة وصادرة) — يتعرض live في /client/dashboard/whatsapp-messages
SHEET_TAB_WHATSAPP_MESSAGES=WhatsAppMessages

# ---- Gemini API (لجلب مواصفات صيانة السيارات لما مش موجودة في الكتالوج المحلي) ----
# خد مفتاح مجاني من https://aistudio.google.com/apikey
GEMINI_API_KEY=
# اختياري: غيّر الموديل لو عايز (الافتراضي gemini-2.5-flash - سريع ورخيص ومناسب للمهمة دي)
GEMINI_MODEL=gemini-2.5-flash

# ---- OpenWeather (درجة الحرارة الحقيقية في العداد) ----
# سجل حساب مجاني على https://openweathermap.org/api وخد API Key من هناك
OPENWEATHER_API_KEY=

# ---- Company / WhatsApp (رسالة الشركة اليدوية / رابط "تواصل معنا") ----
# رقم واتساب الشركة بصيغة دولية بدون + وبدون مسافات (مثال مصر: 20xxxxxxxxxx)
# لازم NEXT_PUBLIC_ عشان بيتقرا من صفحة العميل (Client Component) في المتصفح
NEXT_PUBLIC_COMPANY_WHATSAPP_NUMBER=201000000000
COMPANY_NAME="ايديا"

# ---- WhatsApp Cloud API (Meta) — الأزرار التفاعلية + رسالة الصباح اليومية ----
# من https://developers.facebook.com/apps -> WhatsApp -> API Setup
PHONE_NUMBER_ID=
WABA_ID=
ACCESS_TOKEN=
# أي نص سري تختاره بنفسك، بيتحط في Meta webhook config بالظبط زي ما هو هنا
WEBHOOK_VERIFY_TOKEN=

# رقم تجربتك الشخصي (بصيغة دولية بدون + ) — يستخدم في زرار "إرسال رسالة تجريبية"
WHATSAPP_TEST_RECIPIENT=

# سويتش عام (Kill-switch) لرسالة الصباح اليومية لكل العملاء. الإعداد الفعلي لكل
# عميل بيتحفظ في D.settings.morningMessageEnabled بتاعه (من صفحة إعداداته)،
# لكن لو حطيت القيمة دي false هنا، مفيش رسالة صباح هتتبعت لحد حتى لو مفعّلها.
MORNING_MESSAGE_ENABLED=true

# سر بسيط لحماية endpoint الكرون (/api/whatsapp/send-morning-message) من إنه
# ينادى من أي حد عن طريق الخطأ. Vercel Cron بيبعته تلقائي كـ Header؛ لو
# بتستخدم كرون خارجي (cron-job.org مثلاً) حط نفس القيمة في الـ URL أو الـ header.
CRON_SECRET=change-this-cron-secret

# ---- Supabase (اختياري - مرحلة قادمة للمزامنة اللحظية) ----
# سيبها فاضية دلوقتي؛ النظام شغال بالكامل بـ Google Sheets. لما تجهز Supabase هنفعّل
# realtime sync طبقة فوق نفس الـ API routes من غير ما نكسر حاجة.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase (التخزين الأساسي — الشيت بيبقى باك اب تلقائي) ──
# من Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...   # الـ service_role secret (مش الـ anon!)
